    function backupManager() {
      return {
        lang: localStorage.getItem('cbm_lang') || 'vi',
        darkMode: (localStorage.getItem('cbm_theme') || 'dark') === 'dark',
        activeTab: 'apps',
        filterApp: 'ALL',
        openDetails: {},
        savingSettings: false,
        progressMinimized: false,
        pollTimer: null,
        recreateContainer: localStorage.getItem('cbm_recreate') === 'true',
        savedRecreateContainer: localStorage.getItem('cbm_recreate') === 'true',
        originalSettingsJson: '',
        showRcloneEditor: false,
        showImportKey: false,
        importKeyText: '',
        toast: { message: '', type: 'success' },
        task: { active: false, title: '', detail: '', progress: 0, status: 'idle' },
        selectMode: false,
        selectedApps: [],
        deletingBackup: false,
        cloudModal: { open: false, mode: 'push', targetApp: 'ALL', availableApps: [], loadingList: false },
        restoreModal: { open: false, snap: null, versions: [], selectedVersionId: '', source: 'ssd' },
        deleteModal: { open: false, snap: null, versions: [], selectedVersionId: '' },
        data: {
          disk: { free_gb: 0, appdata_size_mb: 0, backup_size_mb: 0 },
          containers: [],
          app_names: [],
          ssd_apps: [],
          cloud_apps: [],
          backups: [],
          settings: { backup_mode: 'local_cloud', retention_count: 5, excluded_auto_apps: [], ha_schedule_enabled: true, ha_schedule: '30 3 * * 0', ha_auto_clean: true },
          rclone: { configured: false, remotes: [], config_text: '' }
        },
        initApp() {
          this.applyTheme();
          this.loadOverview(true);
        },
        t(key) {
          return (I18N[this.lang] && I18N[this.lang][key]) || key;
        },
        toggleLang() {
          this.lang = this.lang === 'vi' ? 'en' : 'vi';
          localStorage.setItem('cbm_lang', this.lang);
        },
        toggleTheme() {
          this.darkMode = !this.darkMode;
          localStorage.setItem('cbm_theme', this.darkMode ? 'dark' : 'light');
          this.applyTheme();
        },
        applyTheme() {
          document.documentElement.classList.toggle('dark', this.darkMode);
        },
        runningCount() {
          return this.data.containers.filter(c => c.status === 'running').length;
        },
        formatMode(mode) {
          if (mode === 'local_cloud') return 'Local + Cloud';
          return mode || 'Local';
        },
        toggleAppDetail(id) {
          this.openDetails[id] = !this.openDetails[id];
        },
        toggleSelectMode() {
          this.selectMode = !this.selectMode;
          this.selectedApps = [];
        },
        toggleSelectApp(name) {
          if (this.selectedApps.includes(name)) {
            this.selectedApps = this.selectedApps.filter(x => x !== name);
          } else {
            this.selectedApps.push(name);
          }
        },
        async runSelectedBackups() {
          if (this.selectedApps.length === 0) return;
          const targets = [...this.selectedApps];
          this.selectMode = false;
          this.selectedApps = [];
          try {
            const res = await fetch('/api/backup-batch', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ app_names: targets })
            });
            await this.parseResponse(res);
            this.task = { active: true, title: this.t('processing'), detail: targets.join(', '), progress: 10 };
            this.startPollingTask();
          } catch (e) {
            this.showToast(e.message, 'error');
          }
        },
        filteredBackups() {
          const list = this.filterApp === 'ALL'
            ? (this.data.backups || [])
            : (this.data.backups || []).filter(b => b.app_name === this.filterApp);
          const groups = {};
          for (const b of list) {
            if (!groups[b.app_name]) {
              groups[b.app_name] = {
                ...b,
                versions: [b],
                versions_count: 1,
                any_ssd: Boolean(b.on_ssd),
                any_cloud: Boolean(b.on_cloud)
              };
            } else {
              groups[b.app_name].versions.push(b);
              groups[b.app_name].versions_count++;
              if (b.on_ssd) groups[b.app_name].any_ssd = true;
              if (b.on_cloud) groups[b.app_name].any_cloud = true;
            }
          }
          return Object.values(groups).map(g => ({
            ...g,
            on_ssd: g.any_ssd,
            on_cloud: g.any_cloud
          }));
        },
        snapshotSettingsState() {
          const s = this.data.settings || {};
          return JSON.stringify({
            backup_mode: s.backup_mode,
            retention_count: Number(s.retention_count),
            schedule_enabled: Boolean(s.schedule_enabled),
            schedule: s.schedule,
            excluded_auto_apps: [...(s.excluded_auto_apps || [])].sort(),
            ha_schedule_enabled: Boolean(s.ha_schedule_enabled),
            ha_schedule: s.ha_schedule || '30 3 * * 0',
            ha_auto_clean: Boolean(s.ha_auto_clean),
            encryption_enabled: Boolean(s.encryption_enabled),
            encryption_password: s.encryption_password,
            rclone_remote: s.rclone_remote
          });
        },
        isSettingsDirty() {
          if (!this.originalSettingsJson) return false;
          return this.snapshotSettingsState() !== this.originalSettingsJson || this.recreateContainer !== this.savedRecreateContainer;
        },
        showToast(msg, type = 'success') {
          this.toast = { message: msg, type };
          setTimeout(() => { this.toast.message = ''; }, 5000);
        },
        async parseResponse(res) {
          const text = await res.text();
          let json = {};
          try { json = JSON.parse(text); } catch (e) { throw new Error(text || `HTTP ${res.status}`); }
          if (!res.ok) throw new Error(json.detail || json.message || `Error ${res.status}`);
          return json;
        },
        async loadOverview(refreshCloud = false) {
          try {
            const url = refreshCloud ? '/api/overview?refresh_cloud=true' : '/api/overview';
            const res = await fetch(url);
            const out = await this.parseResponse(res);
            this.data = out;
            this.originalSettingsJson = this.snapshotSettingsState();
            if (out.task && out.task.active) {
              this.task = out.task;
              this.startPollingTask();
            }
          } catch (e) {
            this.showToast(e.message, 'error');
          }
        },
        startPollingTask() {
          if (this.pollTimer) clearInterval(this.pollTimer);
          this.progressMinimized = false;
          this.pollTimer = setInterval(async () => {
            try {
              const res = await fetch('/api/task-status');
              const st = await res.json();
              this.task = st;
              if (!st.active) {
                clearInterval(this.pollTimer);
                this.pollTimer = null;
                if (st.status === 'completed') {
                  this.showToast(st.title + (st.detail ? ' — ' + st.detail : ''), 'success');
                } else if (st.status === 'cancelled') {
                  this.showToast(st.title, 'error');
                } else if (st.status === 'error') {
                  this.showToast(st.detail || st.title, 'error');
                }
                await this.loadOverview(false);
              }
            } catch (e) {
              clearInterval(this.pollTimer);
              this.pollTimer = null;
            }
          }, 1000);
        },
        async cancelRunningTask() {
          try {
            await fetch('/api/task/cancel', { method: 'POST' });
            this.task.active = false;
            this.showToast(this.lang === 'vi' ? 'Đã dừng tiến trình!' : 'Task cancelled!', 'error');
            await this.loadOverview(false);
          } catch (e) {
            this.showToast(e.message, 'error');
          }
        },
        async runBackup(appName) {
          try {
            const res = await fetch(`/api/backup/${appName}`, { method: 'POST' });
            await this.parseResponse(res);
            this.task = { active: true, title: this.t('processing'), detail: appName, progress: 10 };
            this.startPollingTask();
          } catch (e) {
            this.showToast(e.message, 'error');
          }
        },
        async openCloudDialog(mode) {
          this.cloudModal.mode = mode;
          this.cloudModal.targetApp = 'ALL';
          this.cloudModal.open = true;

          if (mode === 'push') {
            this.cloudModal.loadingList = false;
            this.cloudModal.availableApps = this.data.ssd_apps || [];
          } else {
            // Khi bấm Pull Cloud -> Quét trực tiếp từ Cloud xem có những file/app nào đang có trên Cloud
            this.cloudModal.loadingList = true;
            this.cloudModal.availableApps = this.data.cloud_apps || [];
            try {
              const res = await fetch('/api/cloud/apps');
              const out = await this.parseResponse(res);
              this.cloudModal.availableApps = out.apps || [];
            } catch (e) {
              // Giữ danh sách từ cache nếu lỗi
            } finally {
              this.cloudModal.loadingList = false;
            }
          }
        },
        async confirmCloudModal() {
          const mode = this.cloudModal.mode;
          const targetApp = this.cloudModal.targetApp;
          this.cloudModal.open = false;

          const endpoint = mode === 'push' ? '/api/cloud/sync-up' : '/api/cloud/pull-catalog';
          try {
            const res = await fetch(endpoint, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ app_name: targetApp })
            });
            await this.parseResponse(res);
            this.task = {
              active: true,
              title: mode === 'push' ? 'Cloud Push...' : 'Cloud Pull...',
              detail: targetApp,
              progress: 15
            };
            this.startPollingTask();
          } catch (e) {
            this.showToast(e.message, 'error');
          }
        },
        openRestoreDialog(groupSnap) {
          const versions = groupSnap.versions || [groupSnap];
          const latest = versions[0];
          this.restoreModal.versions = versions;
          this.restoreModal.selectedVersionId = latest.version_id;
          this.restoreModal.snap = latest;
          this.restoreModal.source = latest.on_ssd ? 'ssd' : 'cloud';
          this.restoreModal.open = true;
        },
        onRestoreVersionChange() {
          const found = (this.restoreModal.versions || []).find(v => v.version_id === this.restoreModal.selectedVersionId);
          if (found) {
            this.restoreModal.snap = found;
            if (this.restoreModal.source === 'ssd' && !found.on_ssd && found.on_cloud) {
              this.restoreModal.source = 'cloud';
            } else if (this.restoreModal.source === 'cloud' && !found.on_cloud && found.on_ssd) {
              this.restoreModal.source = 'ssd';
            }
          }
        },
        async confirmRestoreModal() {
          const snap = this.restoreModal.snap;
          const source = this.restoreModal.source;
          this.restoreModal.open = false;
          if (!snap) return;

          this.task = { active: true, title: `Restore ${snap.app_name}...`, detail: `${snap.version_id} (${source.toUpperCase()})`, progress: 20 };
          this.startPollingTask();
          try {
            const res = await fetch('/api/restore', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                app_name: snap.app_name,
                version_id: snap.version_id,
                source: source,
                recreate_container: this.recreateContainer
              })
            });
            const out = await this.parseResponse(res);
            this.showToast(out.message, 'success');
            await this.loadOverview(false);
          } catch (e) {
            this.showToast(e.message, 'error');
          }
        },
        openDeleteDialog(groupSnap) {
          const versions = groupSnap.versions || [groupSnap];
          const latest = versions[0];
          this.deleteModal.versions = versions;
          this.deleteModal.selectedVersionId = latest.version_id;
          this.deleteModal.snap = latest;
          this.deletingBackup = false;
          this.deleteModal.open = true;
        },
        onDeleteVersionChange() {
          const found = (this.deleteModal.versions || []).find(v => v.version_id === this.deleteModal.selectedVersionId);
          if (found) {
            this.deleteModal.snap = found;
          }
        },
        async confirmDelete(target) {
          const snap = this.deleteModal.snap;
          if (!snap || this.deletingBackup) return;
          this.deletingBackup = true;
          this.task = {
            active: true,
            title: this.t('deletingProgress'),
            detail: `${snap.app_name} (${snap.timestamp_str})`,
            progress: 50
          };
          try {
            const res = await fetch(`/api/backup/${snap.app_name}/${snap.version_id}?target=${target}`, { method: 'DELETE' });
            await this.parseResponse(res);
            this.deleteModal.open = false;
            this.showToast(this.lang === 'vi' ? 'Đã xóa bản sao lưu!' : 'Snapshot deleted!');
            await this.loadOverview(false);
          } catch (e) {
            this.showToast(e.message, 'error');
          } finally {
            this.deletingBackup = false;
            this.task.active = false;
          }
        },
        async saveSettings() {
          if (!this.isSettingsDirty()) return;
          this.savingSettings = true;
          try {
            localStorage.setItem('cbm_recreate', this.recreateContainer);
            this.savedRecreateContainer = this.recreateContainer;
            const res = await fetch('/api/settings', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(this.data.settings)
            });
            await this.parseResponse(res);
            await this.loadOverview(false);
            this.showToast(this.lang === 'vi' ? 'Đã lưu thay đổi thành công!' : 'Settings saved successfully!');
          } catch (e) {
            this.showToast(e.message, 'error');
          } finally {
            this.savingSettings = false;
          }
        },
        async saveRcloneConfig() {
          try {
            const res = await fetch('/api/rclone/config', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ config_text: this.data.rclone.config_text })
            });
            await this.parseResponse(res);
            this.showToast(this.lang === 'vi' ? 'Đã lưu file rclone.conf!' : 'Saved rclone.conf!');
            this.showRcloneEditor = false;
            await this.loadOverview(true);
          } catch (e) {
            this.showToast(e.message, 'error');
          }
        },
        async copyRecoveryKey() {
          try {
            const res = await fetch('/api/recovery-key');
            const out = await this.parseResponse(res);
            await ((text) => {
            if (navigator.clipboard && window.isSecureContext) {
                return navigator.clipboard.writeText(text);
            } else {
                return new Promise((resolve, reject) => {
                    const ta = document.createElement('textarea');
                    ta.value = text;
                    ta.style.position = 'fixed';
                    ta.style.left = '-9999px';
                    ta.style.top = '0';
                    document.body.appendChild(ta);
                    ta.focus();
                    ta.select();
                    try {
                        document.execCommand('copy');
                        document.body.removeChild(ta);
                        resolve();
                    } catch (e) {
                        document.body.removeChild(ta);
                        reject(e);
                    }
                });
            }
        })(out.recovery_key);
            this.showToast(this.lang === 'vi' ? 'Đã sao chép Khóa Khôi Phục vào bộ nhớ tạm! Hãy dán vào Ghi chú iPhone.' : 'Recovery Key copied to clipboard! Save it.');
          } catch (e) {
            this.showToast(e.message, 'error');
          }
        },
        async applyRecoveryKey() {
          if (!this.importKeyText.trim()) return;
          try {
            const res = await fetch('/api/recovery-key', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ recovery_key: this.importKeyText.trim() })
            });
            await this.parseResponse(res);
            this.showImportKey = false;
            this.importKeyText = '';
            this.showToast(this.lang === 'vi' ? 'Đã khôi phục kết nối Google Drive & Cài đặt thành công!' : 'Cloud connection & settings restored!');
            await this.loadOverview(true);
          } catch (e) {
            this.showToast(e.message, 'error');
          }
        }
      }
    }
  </script>
</body>
