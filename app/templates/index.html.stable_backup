<!DOCTYPE html>
<html lang="vi" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>CasaOS Backup Manager</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            darkbg: '#0a0d12',
            darkcard: '#131720',
            darkborder: '#222834'
          }
        }
      }
    }
  </script>
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  <style>
    [x-cloak] { display: none !important; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Segoe UI", Roboto, sans-serif;
      -webkit-tap-highlight-color: transparent;
      -webkit-font-smoothing: antialiased;
    }
  </style>
</head>
<body class="min-h-screen bg-[#f2f2f7] text-slate-900 dark:bg-darkbg dark:text-slate-100 transition-colors duration-200 pb-32"
      x-data="backupManager()" x-init="initApp()" x-cloak>

  <!-- 1. FLOATING TOAST POPUP -->
  <div x-show="toast.message"
       x-transition:enter="transition ease-out duration-300"
       x-transition:enter-start="opacity-0 -translate-y-6 scale-95"
       x-transition:enter-end="opacity-100 translate-y-0 scale-100"
       x-transition:leave="transition ease-in duration-200"
       x-transition:leave-start="opacity-100 translate-y-0 scale-100"
       x-transition:leave-end="opacity-0 -translate-y-6 scale-95"
       class="fixed top-4 inset-x-4 max-w-md mx-auto z-50 pointer-events-auto">
    <div class="p-3.5 rounded-2xl border shadow-2xl backdrop-blur-xl flex items-center justify-between gap-3 text-xs sm:text-sm"
         :class="toast.type === 'error'
           ? 'bg-red-950/95 border-red-600/80 text-red-100 shadow-red-950/50'
           : 'bg-emerald-950/95 border-emerald-500/80 text-emerald-100 shadow-emerald-950/50'">
      <div class="flex items-center gap-2.5 min-w-0">
        <div class="w-6 h-6 rounded-full flex items-center justify-center shrink-0"
             :class="toast.type === 'error' ? 'bg-red-500/20 text-red-400' : 'bg-emerald-500/20 text-emerald-400'">
          <svg x-show="toast.type !== 'error'" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
          </svg>
          <svg x-show="toast.type === 'error'" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m0 3.75h.008v.008H12v-.008z"/>
          </svg>
        </div>
        <span class="font-semibold break-words leading-snug" x-text="toast.message"></span>
      </div>
      <button @click="toast.message = ''" class="text-xs font-semibold opacity-80 hover:opacity-100 px-2 py-1 rounded-lg bg-white/10 shrink-0" x-text="t('close')"></button>
    </div>
  </div>

  <!-- 2. FLOATING BACKGROUND TASK PROGRESS BAR (Có nút Hủy & nút Thu gọn) -->
  <div x-show="task.active" class="fixed bottom-5 inset-x-4 max-w-md mx-auto z-40 pointer-events-auto">
    <div x-show="!progressMinimized" x-transition
         class="bg-white/95 dark:bg-[#181d28]/95 backdrop-blur-xl border border-blue-500/40 rounded-2xl p-4 shadow-2xl space-y-2.5">
      <div class="flex items-center justify-between gap-2">
        <div class="flex items-center gap-2.5 min-w-0">
          <svg class="w-4 h-4 text-blue-500 animate-spin shrink-0" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
          </svg>
          <span class="text-xs sm:text-sm font-bold truncate" x-text="task.title"></span>
        </div>
        <div class="flex items-center gap-1.5 shrink-0">
          <!-- Nút Hủy Tiến Trình -->
          <button @click="cancelRunningTask()"
                  class="text-[11px] font-semibold px-2.5 py-1 rounded-lg bg-rose-500/15 text-rose-500 hover:bg-rose-500/25 border border-rose-500/30 transition"
                  x-text="t('cancelTaskBtn')">
          </button>
          <!-- Nút Thu gọn -->
          <button @click="progressMinimized = true"
                  class="text-[11px] font-semibold px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-300 hover:bg-slate-200 transition"
                  x-text="t('hideProgress')">
          </button>
        </div>
      </div>
      <p class="text-[11px] text-slate-500 dark:text-slate-400 truncate" x-text="task.detail"></p>
      <div class="w-full h-2 bg-slate-200 dark:bg-slate-800 rounded-full overflow-hidden">
        <div class="h-full bg-gradient-to-r from-blue-500 to-purple-500 transition-all duration-500 rounded-full"
             :style="`width: ${Math.max(task.progress || 10, 8)}%`"></div>
      </div>
    </div>

    <div x-show="progressMinimized" x-transition class="flex justify-end gap-2">
      <button @click="progressMinimized = false"
              class="bg-blue-600 text-white text-xs font-semibold px-3.5 py-2 rounded-full shadow-xl flex items-center gap-2 border border-blue-400/40">
        <svg class="w-3.5 h-3.5 animate-spin" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
        </svg>
        <span x-text="(task.progress || 10) + '%'"></span>
      </button>
    </div>
  </div>

  <!-- 3. MODAL PUSH / PULL CLOUD (CHỈ HIỆN ĐÚNG APP ĐANG CÓ TRÊN CLOUD KHI PULL) -->
  <div x-show="cloudModal.open" x-transition.opacity
       class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div @click.away="cloudModal.open = false"
         class="bg-white dark:bg-darkcard border border-slate-200 dark:border-darkborder rounded-3xl max-w-sm w-full p-5 shadow-2xl space-y-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-xl flex items-center justify-center"
               :class="cloudModal.mode === 'push' ? 'bg-blue-500/15 text-blue-500' : 'bg-purple-500/15 text-purple-500'">
            <svg x-show="cloudModal.mode === 'push'" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V9.75m0 0l3 3m-3-3l-3 3M6.75 19.5a4.5 4.5 0 01-1.41-8.775 5.25 5.25 0 0110.233-2.33 3 3 0 013.758 3.848A3.752 3.752 0 0118 19.5H6.75z"/>
            </svg>
            <svg x-show="cloudModal.mode === 'pull'" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9.75v6.75m0 0l-3-3m3 3l3-3m-8.25 6a4.5 4.5 0 01-1.41-8.775 5.25 5.25 0 0110.233-2.33 3 3 0 013.758 3.848A3.752 3.752 0 0118 19.5H6.75z"/>
            </svg>
          </div>
          <h3 class="text-base font-bold" x-text="cloudModal.mode === 'push' ? t('pushModalTitle') : t('pullModalTitle')"></h3>
        </div>
        <button @click="cloudModal.open = false" class="p-1 text-slate-400 hover:text-slate-200">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <p class="text-xs text-slate-500 dark:text-slate-400"
         x-text="cloudModal.mode === 'push' ? t('pushModalDesc') : t('pullModalDesc')"></p>

      <!-- Trạng thái đang kiểm tra dữ liệu thực tế trên Cloud -->
      <div x-show="cloudModal.loadingList" class="py-4 flex items-center justify-center gap-2 text-xs text-purple-400">
        <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
        </svg>
        <span x-text="t('checkingCloudData')"></span>
      </div>

      <!-- Nếu không có bản lưu nào trên Cloud/SSD -->
      <div x-show="!cloudModal.loadingList && cloudModal.availableApps.length === 0"
           class="p-3.5 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-amber-400 text-xs text-center"
           x-text="cloudModal.mode === 'push' ? t('noSsdAppsToPush') : t('noCloudAppsToPull')">
      </div>

      <!-- Dropdown chỉ hiển thị các App thực sự có dữ liệu -->
      <div x-show="!cloudModal.loadingList && cloudModal.availableApps.length > 0" class="space-y-1.5">
        <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400" x-text="t('selectTargetApp')"></label>
        <select x-model="cloudModal.targetApp"
                class="w-full h-11 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-darkborder rounded-xl px-3 text-xs sm:text-sm font-semibold">
          <option value="ALL" x-text="t('allAvailableOption') + ' (' + cloudModal.availableApps.length + ' apps)'"></option>
          <template x-for="name in cloudModal.availableApps" :key="name">
            <option :value="name" x-text="name"></option>
          </template>
        </select>
      </div>

      <div class="grid grid-cols-2 gap-2.5 pt-2">
        <button @click="cloudModal.open = false"
                class="h-10 rounded-xl border border-slate-200 dark:border-darkborder text-xs font-semibold"
                x-text="t('cancelBtn')">
        </button>
        <button @click="confirmCloudModal()"
                :disabled="cloudModal.loadingList || cloudModal.availableApps.length === 0"
                class="h-10 rounded-xl text-white text-xs font-semibold shadow-sm disabled:opacity-40"
                :class="cloudModal.mode === 'push' ? 'bg-blue-600 hover:bg-blue-500' : 'bg-purple-600 hover:bg-purple-500'"
                x-text="cloudModal.mode === 'push' ? t('startPushBtn') : t('startPullBtn')">
        </button>
      </div>
    </div>
  </div>

  <!-- 4. MODAL CHỌN NGUỒN KHÔI PHỤC (SSD HAY CLOUD) -->
  <div x-show="restoreModal.open" x-transition.opacity
       class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div @click.away="restoreModal.open = false"
         class="bg-white dark:bg-darkcard border border-slate-200 dark:border-darkborder rounded-3xl max-w-sm w-full p-5 shadow-2xl space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="text-base font-bold" x-text="t('restoreModalTitle')"></h3>
        <button @click="restoreModal.open = false" class="p-1 text-slate-400 hover:text-slate-200">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <div class="bg-slate-50 dark:bg-slate-900/70 rounded-2xl p-3.5 text-xs space-y-2.5 border border-slate-200/60 dark:border-darkborder">
        <div class="flex items-center justify-between">
          <div class="font-bold text-emerald-500 text-sm" x-text="restoreModal.snap?.app_name"></div>
          <span class="text-[11px] font-semibold px-2 py-0.5 rounded-md bg-emerald-500/10 text-emerald-400 border border-emerald-500/20"
                x-text="(restoreModal.versions?.length || 1) + ' ' + t('versionsCountLabel')"></span>
        </div>
        <div class="space-y-1">
          <label class="block text-[11px] font-semibold text-slate-400" x-text="t('selectVersionLabel')"></label>
          <select x-model="restoreModal.selectedVersionId" @change="onRestoreVersionChange()"
                  class="w-full h-10 bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-xl px-2.5 text-xs font-medium">
            <template x-for="(v, idx) in restoreModal.versions" :key="v.version_id">
              <option :value="v.version_id" x-text="v.timestamp_str + ' • ' + v.size_mb + ' MB' + (idx === 0 ? ' (Latest)' : '')"></option>
            </template>
          </select>
        </div>
      </div>

      <div class="space-y-2">
        <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400" x-text="t('chooseRestoreSource')"></label>

        <button type="button"
                @click="if(restoreModal.snap?.on_ssd) restoreModal.source = 'ssd'"
                :disabled="!restoreModal.snap?.on_ssd"
                class="w-full p-3 rounded-2xl border text-left flex items-center justify-between transition"
                :class="restoreModal.source === 'ssd'
                  ? 'border-blue-500 bg-blue-500/10'
                  : (restoreModal.snap?.on_ssd ? 'border-slate-200 dark:border-darkborder' : 'opacity-40 cursor-not-allowed border-slate-200 dark:border-darkborder')">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-xl bg-blue-500/15 text-blue-500 flex items-center justify-center">
              <!-- Symmetric 3-bar SSD Icon -->
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <rect x="3" y="3.5" width="18" height="4.5" rx="1.5"/>
                <rect x="3" y="9.75" width="18" height="4.5" rx="1.5"/>
                <rect x="3" y="16" width="18" height="4.5" rx="1.5"/>
              </svg>
            </div>
            <div>
              <div class="text-xs font-bold" x-text="t('sourceSsdTitle')"></div>
              <div class="text-[11px] text-slate-400" x-text="restoreModal.snap?.on_ssd ? t('sourceSsdFast') : t('notAvailableSsd')"></div>
            </div>
          </div>
          <div class="w-4 h-4 rounded-full border flex items-center justify-center"
               :class="restoreModal.source === 'ssd' ? 'border-blue-500 bg-blue-500' : 'border-slate-500'">
            <div x-show="restoreModal.source === 'ssd'" class="w-1.5 h-1.5 rounded-full bg-white"></div>
          </div>
        </button>

        <button type="button"
                @click="if(restoreModal.snap?.on_cloud) restoreModal.source = 'cloud'"
                :disabled="!restoreModal.snap?.on_cloud"
                class="w-full p-3 rounded-2xl border text-left flex items-center justify-between transition"
                :class="restoreModal.source === 'cloud'
                  ? 'border-purple-500 bg-purple-500/10'
                  : (restoreModal.snap?.on_cloud ? 'border-slate-200 dark:border-darkborder' : 'opacity-40 cursor-not-allowed border-slate-200 dark:border-darkborder')">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-xl bg-purple-500/15 text-purple-500 flex items-center justify-center">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15a4.5 4.5 0 004.5 4.5H18a3.75 3.75 0 001.332-7.257 3 3 0 00-3.758-3.848 5.25 5.25 0 00-10.233 2.33A4.502 4.502 0 002.25 15z"/>
              </svg>
            </div>
            <div>
              <div class="text-xs font-bold" x-text="t('sourceCloudTitle')"></div>
              <div class="text-[11px] text-slate-400" x-text="restoreModal.snap?.on_cloud ? t('sourceCloudDesc') : t('notAvailableCloud')"></div>
            </div>
          </div>
          <div class="w-4 h-4 rounded-full border flex items-center justify-center"
               :class="restoreModal.source === 'cloud' ? 'border-purple-500 bg-purple-500' : 'border-slate-500'">
            <div x-show="restoreModal.source === 'cloud'" class="w-1.5 h-1.5 rounded-full bg-white"></div>
          </div>
        </button>
      </div>

      <div class="grid grid-cols-2 gap-2.5 pt-2">
        <button @click="restoreModal.open = false"
                class="h-10 rounded-xl border border-slate-200 dark:border-darkborder text-xs font-semibold"
                x-text="t('cancelBtn')">
        </button>
        <button @click="confirmRestoreModal()"
                class="h-10 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold shadow-sm"
                x-text="t('confirmRestoreBtn')">
        </button>
      </div>
    </div>
  </div>

  <!-- 5. MODAL CHỌN NƠI XÓA (CÓ CHỌN PHIÊN BẢN & TRẠNG THÁI ĐANG XÓA) -->
  <div x-show="deleteModal.open" x-transition.opacity
       class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div @click.away="if(!deletingBackup) deleteModal.open = false"
         class="bg-white dark:bg-darkcard border border-slate-200 dark:border-darkborder rounded-3xl max-w-sm w-full p-5 shadow-2xl space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="text-base font-bold text-rose-500" x-text="t('deleteModalTitle')"></h3>
        <span class="text-xs font-bold text-emerald-500" x-text="deleteModal.snap?.app_name"></span>
      </div>

      <div class="space-y-1">
        <label class="block text-[11px] font-semibold text-slate-400" x-text="t('selectVersionLabel')"></label>
        <select x-model="deleteModal.selectedVersionId" @change="onDeleteVersionChange()" :disabled="deletingBackup"
                class="w-full h-10 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-darkborder rounded-xl px-2.5 text-xs font-medium">
          <template x-for="(v, idx) in deleteModal.versions" :key="v.version_id">
            <option :value="v.version_id" x-text="v.timestamp_str + ' • ' + v.size_mb + ' MB' + (idx === 0 ? ' (Latest)' : '')"></option>
          </template>
        </select>
      </div>

      <!-- Thanh tiến trình đang xóa -->
      <div x-show="deletingBackup" class="p-3 rounded-2xl bg-rose-500/10 border border-rose-500/30 flex items-center justify-center gap-2.5 text-xs font-semibold text-rose-400">
        <svg class="w-4 h-4 animate-spin shrink-0" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
        </svg>
        <span x-text="t('deletingProgress')"></span>
      </div>

      <div class="space-y-2" x-show="!deletingBackup">
        <button x-show="deleteModal.snap?.on_ssd && deleteModal.snap?.on_cloud"
                @click="confirmDelete('both')"
                class="w-full h-10 rounded-xl bg-rose-600 hover:bg-rose-500 text-white text-xs font-semibold transition"
                x-text="t('deleteBoth')">
        </button>
        <button x-show="deleteModal.snap?.on_ssd"
                @click="confirmDelete('ssd')"
                class="w-full h-10 rounded-xl border border-slate-200 dark:border-darkborder hover:bg-slate-100 dark:hover:bg-slate-800 text-xs font-semibold transition"
                x-text="t('deleteSsdOnly')">
        </button>
        <button x-show="deleteModal.snap?.on_cloud"
                @click="confirmDelete('cloud')"
                class="w-full h-10 rounded-xl border border-slate-200 dark:border-darkborder hover:bg-slate-100 dark:hover:bg-slate-800 text-xs font-semibold transition"
                x-text="t('deleteCloudOnly')">
        </button>
        <button @click="deleteModal.open = false"
                class="w-full h-10 rounded-xl text-xs font-semibold text-slate-400"
                x-text="t('cancelBtn')">
        </button>
      </div>
    </div>
  </div>

  <!-- MAIN CONTAINER -->
  <div class="max-w-3xl mx-auto px-4 pt-4 space-y-4">

    <!-- TOP BAR -->
    <header class="flex items-center justify-between gap-3 bg-white/90 dark:bg-darkcard/90 backdrop-blur-md border border-slate-200/80 dark:border-darkborder rounded-2xl p-3.5 shadow-sm">
      <div class="flex items-center gap-3 min-w-0 flex-1">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-blue-500 to-blue-600 flex items-center justify-center text-white shadow-sm shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9"/>
          </svg>
        </div>
        <div class="min-w-0 flex-1">
          <h1 class="text-base font-bold tracking-tight truncate">CasaOS Backup</h1>
          <p class="text-xs text-slate-500 dark:text-slate-400 truncate" x-text="t('subtitle')"></p>
        </div>
      </div>

      <div class="flex items-center gap-2 shrink-0">
        <button @click="toggleLang()"
                class="h-9 px-3 rounded-xl text-xs font-semibold whitespace-nowrap inline-flex items-center justify-center gap-1.5 border border-slate-200 dark:border-darkborder bg-slate-100/80 dark:bg-slate-800/80 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 transition">
          <svg class="w-4 h-4 text-blue-500 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418"/>
          </svg>
          <span x-text="lang.toUpperCase()"></span>
        </button>

        <button @click="toggleTheme()"
