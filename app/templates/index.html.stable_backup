          <h3 class="text-sm font-bold" x-text="t('policySection')"></h3>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 mb-1.5" x-text="t('backupMode')"></label>
            <select x-model="data.settings.backup_mode"
                    class="w-full h-10 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-darkborder rounded-xl px-3 text-xs sm:text-sm">
              <option value="local" x-text="t('modeLocal')"></option>
              <option value="local_cloud" x-text="t('modeLocalCloud')"></option>
              <option value="cloud" x-text="t('modeCloud')"></option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 mb-1.5" x-text="t('retentionLabel')"></label>
            <input type="number" min="1" max="50" x-model.number="data.settings.retention_count"
                   class="w-full h-10 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-darkborder rounded-xl px-3 text-xs sm:text-sm" />
            <p class="text-[11px] text-slate-400 mt-1" x-text="t('retentionHint')"></p>
          </div>
        </div>

        <div class="flex items-center justify-between pt-3 border-t border-slate-100 dark:border-darkborder">
          <div class="pr-4">
            <div class="text-xs sm:text-sm font-semibold" x-text="t('recreateLabel')"></div>
            <div class="text-[11px] text-slate-400 mt-0.5" x-text="t('recreateDesc')"></div>
          </div>
          <button type="button" @click="recreateContainer = !recreateContainer"
                  class="relative inline-flex h-6 w-11 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out"
