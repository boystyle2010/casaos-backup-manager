                    <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/>
                    </svg>
                    <span>AES</span>
                  </span>
                </template>
              </div>
            </div>

            <div class="flex flex-wrap items-center justify-between gap-2 text-xs text-slate-400">
              <div class="flex items-center gap-1.5">
                <span class="px-2 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 font-medium" x-text="b.timestamp_str"></span>
                <span class="px-2 py-0.5 rounded-md bg-blue-500/10 text-blue-500 dark:text-blue-400 font-semibold" x-text="b.size_mb + ' MB'"></span>
