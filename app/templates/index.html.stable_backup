            <span class="pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out"
                  :class="recreateContainer ? 'translate-x-5' : 'translate-x-0'"></span>
          </button>
        </div>
      </div>

      <!-- Group 2: Automation & Security -->
      <div class="bg-white dark:bg-darkcard border border-slate-200/80 dark:border-darkborder rounded-2xl p-5 space-y-4 shadow-sm">
        <div class="flex items-center gap-2 border-b border-slate-100 dark:border-darkborder pb-2.5">
          <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/>
          </svg>
          <h3 class="text-sm font-bold" x-text="t('scheduleSecuritySection')"></h3>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold" x-text="t('autoSchedule')"></span>
              <button type="button" @click="data.settings.schedule_enabled = !data.settings.schedule_enabled"
                      class="relative inline-flex h-6 w-11 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out"
                      :class="data.settings.schedule_enabled ? 'bg-blue-600' : 'bg-slate-300 dark:bg-slate-700'">
                <span class="pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out"
                      :class="data.settings.schedule_enabled ? 'translate-x-5' : 'translate-x-0'"></span>
              </button>
            </div>
            <input type="text" x-model="data.settings.schedule" placeholder="0 3 * * *"
                   class="w-full h-10 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-darkborder rounded-xl px-3 text-xs font-mono" />
            <p class="text-[11px] text-slate-400" x-text="t('cronHint')"></p>
                <div class="pt-2 space-y-1.5" x-show="data.settings.schedule_enabled">
                  <p class="text-[11px] font-medium text-slate-400" x-text="t('autoBackupApps')"></p>
                  <div class="flex flex-wrap gap-1.5 pt-0.5">
                    <template x-for="c in data.containers" :key="c.name">
                      <button type="button"
                        @click="const ex = [...(data.settings.excluded_auto_apps || [])]; data.settings.excluded_auto_apps = ex.includes(c.name) ? ex.filter(x => x !== c.name) : [...ex, c.name]; data.settings = { ...data.settings }"
                        class="px-2.5 py-1 rounded-lg text-[11px] font-medium border transition-all flex items-center gap-1.5"
                        :class="!(data.settings.excluded_auto_apps || []).includes(c.name) ? 'bg-blue-600/15 border-blue-500/40 text-blue-400' : 'bg-slate-800/40 border-slate-700/50 text-slate-500 line-through opacity-60'">
                        <span class="w-1.5 h-1.5 rounded-full" :class="!(data.settings.excluded_auto_apps || []).includes(c.name) ? 'bg-blue-400' : 'bg-slate-600'"></span>
                        <span x-text="c.name"></span>
                      </button>
                    </template>
                  </div>
                </div>
          <!-- Khung thiết lập riêng cho Home Assistant -->
          <div class="mt-3 pt-3 border-t border-slate-200/60 dark:border-slate-800/80 space-y-2.5">
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold text-blue-400" x-text="t('haScheduleTitle')"></span>
              <button type="button" @click="data.settings.ha_schedule_enabled = !data.settings.ha_schedule_enabled; data.settings = { ...data.settings }"
                class="relative inline-flex h-6 w-11 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out"
                :class="data.settings.ha_schedule_enabled ? 'bg-blue-600' : 'bg-slate-300 dark:bg-slate-700'">
                <span class="pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out"
                  :class="data.settings.ha_schedule_enabled ? 'translate-x-5' : 'translate-x-0'"></span>
              </button>
            </div>
            <div x-show="data.settings.ha_schedule_enabled" class="space-y-2">
              <select x-model="data.settings.ha_schedule" @change="data.settings = { ...data.settings }"
                class="w-full h-10 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-darkborder rounded-xl px-3 text-xs font-medium">
                <option value="30 3 * * 0" x-text="t('haFreqWeekly')"></option>
                <option value="30 3 1,15 * *" x-text="t('haFreqBiweekly')"></option>
                <option value="30 3 1 * *" x-text="t('haFreqMonthly')"></option>
              </select>
              <input type="text" x-model="data.settings.ha_schedule" @input="data.settings = { ...data.settings }" placeholder="30 3 * * 0"
                class="w-full h-9 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-darkborder rounded-xl px-3 text-[11px] font-mono text-slate-400" />
            </div>
            <label class="flex items-center gap-2 pt-1 cursor-pointer select-none">
              <input type="checkbox" x-model="data.settings.ha_auto_clean" @change="data.settings = { ...data.settings }" class="rounded border-slate-600 text-blue-600 focus:ring-blue-500 bg-slate-900 w-4 h-4" />
              <span class="text-[11px] text-slate-300 leading-tight" x-text="t('haCleanLabel')"></span>
            </label>
          </div>
          </div>

          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold" x-text="t('encryptionLabel')"></span>
              <button type="button" @click="data.settings.encryption_enabled = !data.settings.encryption_enabled"
                      class="relative inline-flex h-6 w-11 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out"
                      :class="data.settings.encryption_enabled ? 'bg-blue-600' : 'bg-slate-300 dark:bg-slate-700'">
                <span class="pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out"
                      :class="data.settings.encryption_enabled ? 'translate-x-5' : 'translate-x-0'"></span>
              </button>
            </div>
            <input type="password" x-model="data.settings.encryption_password" :placeholder="t('passwordPlaceholder')"
                   class="w-full h-10 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-darkborder rounded-xl px-3 text-xs" />
            <p class="text-[11px] text-slate-400" x-text="t('encHint')"></p>
          </div>
        </div>
      </div>

      <!-- Group 3: Cloud Rclone & 1-Tap Recovery Key -->
      <div class="bg-white dark:bg-darkcard border border-slate-200/80 dark:border-darkborder rounded-2xl p-5 space-y-4 shadow-sm">
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-darkborder pb-2.5">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-purple-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15a4.5 4.5 0 004.5 4.5H18a3.75 3.75 0 001.332-7.257 3 3 0 00-3.758-3.848 5.25 5.25 0 00-10.233 2.33A4.502 4.502 0 002.25 15z"/>
            </svg>
            <h3 class="text-sm font-bold" x-text="t('cloudSection')"></h3>
          </div>
          <span class="text-[11px] px-2.5 py-0.5 rounded-full font-medium"
                :class="data.rclone.configured ? 'bg-emerald-500/10 text-emerald-500' : 'bg-amber-500/10 text-amber-500'"
                x-text="data.rclone.configured ? t('cloudConnected') + ' (' + data.rclone.remotes.join(', ') + ')' : t('cloudNotSet')"></span>
        </div>

        <div class="space-y-3">
          <div>
            <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 mb-1.5" x-text="t('remotePathLabel')"></label>
            <div class="flex gap-2">
              <input type="text" x-model="data.settings.rclone_remote" placeholder="gdrive:CasaOS_Backups"
                     class="flex-1 h-10 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-darkborder rounded-xl px-3 text-xs font-mono" />
              <button @click="showRcloneEditor = !showRcloneEditor"
                      class="h-10 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-xs font-semibold px-3.5 rounded-xl border border-slate-200 dark:border-slate-700 transition whitespace-nowrap"
                      x-text="t('editRcloneBtn')">
              </button>
            </div>
          </div>

          <div x-show="showRcloneEditor" x-transition class="space-y-2 pt-2">
            <label class="block text-xs text-slate-400"><code>/root/.config/rclone/rclone.conf</code></label>
            <textarea x-model="data.rclone.config_text" rows="5"
                      class="w-full bg-slate-950 text-emerald-400 border border-slate-700 rounded-xl p-3 text-xs font-mono"></textarea>
            <div class="flex justify-end">
              <button @click="saveRcloneConfig()" class="h-9 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold px-4 rounded-xl">
                <span x-text="t('saveRcloneBtn')"></span>
              </button>
            </div>
          </div>

          <!-- 1-Tap Recovery Key (Dùng khi cài lại máy mới không cần đăng nhập lại Google) -->
          <div class="pt-3 border-t border-slate-100 dark:border-darkborder space-y-2">
            <div class="flex items-center justify-between">
              <div>
                <div class="text-xs font-bold text-purple-400" x-text="t('recoveryKeyTitle')"></div>
                <div class="text-[11px] text-slate-400" x-text="t('recoveryKeyDesc')"></div>
              </div>
              <div class="flex gap-1.5 shrink-0">
                <button @click="copyRecoveryKey()"
                        class="h-8 px-2.5 rounded-lg bg-purple-500/15 text-purple-400 hover:bg-purple-500/25 text-[11px] font-semibold border border-purple-500/30 transition"
                        x-text="t('exportKeyBtn')">
                </button>
                <button @click="showImportKey = !showImportKey"
                        class="h-8 px-2.5 rounded-lg bg-slate-100 dark:bg-slate-800 text-[11px] font-semibold border border-slate-200 dark:border-slate-700 transition"
                        x-text="t('importKeyBtn')">
                </button>
              </div>
            </div>

            <div x-show="showImportKey" x-transition class="flex gap-2 pt-1">
              <input type="text" x-model="importKeyText" placeholder="CBMKEY:ey..."
                     class="flex-1 h-9 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-darkborder rounded-xl px-3 text-xs font-mono" />
              <button @click="applyRecoveryKey()"
                      class="h-9 bg-purple-600 hover:bg-purple-500 text-white text-xs font-semibold px-3.5 rounded-xl shrink-0"
                      x-text="t('applyKeyBtn')">
              </button>
            </div>
          </div>

          <div class="text-xs text-slate-400 flex items-center justify-between pt-1">
            <span><span x-text="t('lastSync')"></span>: <b class="text-slate-600 dark:text-slate-300" x-text="data.settings.last_cloud_sync"></b></span>
          </div>
        </div>
      </div>

      <!-- SMART SAVE BUTTON -->
      <div class="flex justify-end pt-1">
        <button @click="saveSettings()"
                :disabled="!isSettingsDirty() || savingSettings"
                class="w-full sm:w-auto h-11 text-xs sm:text-sm font-semibold px-6 rounded-2xl transition-all duration-200 inline-flex items-center justify-center gap-2"
                :class="isSettingsDirty()
                  ? 'bg-blue-600 hover:bg-blue-500 text-white shadow-lg shadow-blue-600/25 cursor-pointer'
                  : 'bg-slate-200 dark:bg-slate-800/70 text-slate-400 dark:text-slate-500 border border-slate-300/50 dark:border-slate-700/50 opacity-60 cursor-not-allowed'">
          <svg x-show="!savingSettings" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
          </svg>
          <svg x-show="savingSettings" class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
          </svg>
          <span x-text="savingSettings ? t('processing') : (isSettingsDirty() ? t('saveSettingsBtn') : t('noChangesBtn'))"></span>
        </button>
      </div>
    </section>

  </div>

